# URL of the monitoring server (the PC running /server)
SERVER_URL=http://192.168.4.10:5000
# Must match AGENT_ENROLL_KEY in server/.env
ENROLL_KEY=SCL-ENROLL-2026
# Optional: force the IP this PC registers with (otherwise auto-detected primary IPv4)
AGENT_IP=
# Optional: friendly name override (defaults to hostname)
AGENT_NAME=
