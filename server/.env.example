# ---------- API ----------
PORT=5000
CORS_ORIGIN=*
# Local timezone offset in minutes used for "Today" / daily report buckets (Bangladesh = 360)
TZ_OFFSET_MIN=360

# ---------- MySQL / MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=server_monitor

# ---------- Security ----------
# Change both of these in production!
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=12h
# Every agent must send this key once to register itself
AGENT_ENROLL_KEY=SCL-ENROLL-2026

# First admin login created by `npm run migrate`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
